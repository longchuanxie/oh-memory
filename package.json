{
  "name": "oh-memory",
  "version": "1.0.0-beta.11",
  "description": "LLM-powered knowledge base plugin for OpenCode",
  "type": "module",
  "main": "dist/plugin.js",
  "types": "dist/plugin.d.ts",
  "bin": {
    "oh-memory": "./dist/cli.js"
  },
  "files": [
    "dist/",
    "templates/",
    "commands/",
    "README.md"
  ],
  "keywords": [
    "opencode",
    "plugin",
    "knowledge-base",
    "llm",
    "wiki",
    "memory"
  ],
  "author": "xielc",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/oh-memory"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": "^1.0.0"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "marked": "^12.0.0",
    "ajv": "^8.12.0",
    "diff": "^5.2.0"
  },
  "devDependencies": {
    "typescript": "^5.0.0",
    "@types/bun": "latest",
    "@types/diff": "^5.0.9"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "prepublishOnly": "npm run build",
    "publish:beta": "npm version prerelease --preid=beta --no-git-tag-version && npm publish --tag beta",
    "publish:rc": "npm version prerelease --preid=rc && npm publish --tag rc",
    "publish:canary": "npm version prerelease --preid=canary && npm publish --tag canary",
    "publish:stable": "npm version patch && npm publish"
  }
}
