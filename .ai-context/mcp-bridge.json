{
  "enabled": false,
  "version": "1.0.0",
  "description": "MCP Bridge for Project Context Protocol — optional integration with external memory systems",
  "endpoints": {
    "memory_get": {
      "description": "Retrieve context from PCP files",
      "parameters": {
        "type": "object",
        "properties": {
          "file": {
            "type": "string",
            "description": "Context file to retrieve (e.g., BOOT.md, PROJECT.md, ARCHITECTURE.md)"
          },
          "channel": {
            "type": "string",
            "description": "Channel to filter by (defaults to current git branch)"
          },
          "query": {
            "type": "string",
            "description": "Search query for session history"
          }
        },
        "required": ["file"]
      },
      "returns": {
        "type": "object",
        "properties": {
          "content": { "type": "string", "description": "File content as markdown" },
          "metadata": { "type": "object", "description": "File metadata (last modified, size)" }
        }
      }
    },
    "memory_update": {
      "description": "Update PCP context files",
      "parameters": {
        "type": "object",
        "properties": {
          "file": {
            "type": "string",
            "description": "Context file to update"
          },
          "content": {
            "type": "string",
            "description": "New content (full file replacement)"
          },
          "append": {
            "type": "boolean",
            "description": "If true, append content instead of replacing",
            "default": false
          },
          "channel": {
            "type": "string",
            "description": "Channel context for the update"
          }
        },
        "required": ["file", "content"]
      },
      "returns": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean" },
          "message": { "type": "string" }
        }
      }
    }
  },
  "compatibility": {
    "mcp-memory-keeper": {
      "description": "Compatible with PACK/mcp-memory-keeper protocol",
      "mapping": {
        "memory_get": "read",
        "memory_update": "write"
      }
    }
  },
  "export": {
    "format": "tar.gz",
    "include": [
      "BOOT.md",
      "PROJECT.md",
      "ARCHITECTURE.md",
      "DECISIONS.md",
      "PATTERNS.md",
      "WORKING.md",
      "CHECKPOINT.md",
      "GLOSSARY.md",
      "SESSIONS/INDEX.md",
      "KNOWLEDGE/"
    ],
    "exclude": [
      "SESSIONS/TEMP/",
      "CHECKPOINT.md.tmp",
      "RECOVERY.md"
    ]
  }
}
