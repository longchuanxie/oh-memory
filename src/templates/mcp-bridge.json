{
  "enabled": false,
  "version": "1.0.0",
  "description": "MCP Bridge for Project Context Protocol — optional integration with external memory systems",
  "endpoints": {
    "memory_get": {
      "description": "Retrieve context from PCP files",
      "parameters": {
        "type": "object",
        "properties": {
          "file": {
            "type": "string",
            "description": "Context file to retrieve"
          },
          "channel": {
            "type": "string",
            "description": "Channel to filter by"
          },
          "query": {
            "type": "string",
            "description": "Search query for session history"
          }
        },
        "required": ["file"]
      }
    },
    "memory_update": {
      "description": "Update PCP context files",
      "parameters": {
        "type": "object",
        "properties": {
          "file": {
            "type": "string",
            "description": "Context file to update"
          },
          "content": {
            "type": "string",
            "description": "New content"
          },
          "append": {
            "type": "boolean",
            "description": "Append instead of replacing",
            "default": false
          }
        },
        "required": ["file", "content"]
      }
    }
  },
  "compatibility": {
    "mcp-memory-keeper": {
      "mapping": {
        "memory_get": "read",
        "memory_update": "write"
      }
    }
  }
}
